generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  user
  admin
}

enum LoginProvider {
  APP
  GOOGLE
  FACEBOOK
}

enum BankProvider {
  BCA
  BNI
  BRI
  MANDIRI
  CIMB
  PERMATA
  DANAMON
  BTN
  BSI
  OTHER
}

enum WalletProvider {
  GOPAY
  OVO
  DANA
  SHOPEEPAY
  LINKAJA
  SAKUKU
  JENIUS
  OTHER
}

enum UploadSourceType {
  BANK
  WALLET
}

enum FileFormat {
  CSV
  XLSX
  XLS
  PDF
}

enum UploadStatus {
  UPLOADING
  PROCESSING
  SUCCESS
  FAILED
  PARTIAL
}

enum TransactionType {
  CREDIT
  DEBIT
}

enum EStatementStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum MergeStatus {
  DRAFT
  MERGED
  CONFLICT
}

enum NotifType {
  success
  error
  warning
  info
}

model User {
  id            String        @id @default(uuid())
  name          String        @default("user")
  email         String        @unique
  password      String
  role          Role          @default(user)
  loginProvider LoginProvider @default(APP)
  createdAt     DateTime      @default(now())

  bankAccounts         BankAccount[]
  uploadedStatements   BankStatementUpload[]
  verifiedTransactions BankTransaction[]     @relation("VerifiedBy")
  mergeReports         MergeReport[]
  wallets              DigitalWallet[]
  uploadedWalletStmts  WalletStatementUpload[]
  verifiedWalletTx     WalletTransaction[]   @relation("WalletVerifiedBy")
  notifications        Notification[]
  transactionCategories TransactionCategory[]
}

model BankAccount {
  id            String       @id @default(uuid())
  bankProvider  BankProvider
  accountNumber String       @unique
  accountName   String
  currency      String       @default("IDR")
  description   String?
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  ownerId       String

  owner        User                  @relation(fields: [ownerId], references: [id])
  uploads      BankStatementUpload[]
  transactions BankTransaction[]

  @@index([bankProvider])
  @@index([ownerId])
}

model BankStatementUpload {
  id            String       @id @default(uuid())
  bankAccountId String
  uploadedById  String
  fileName      String
  fileUrl       String
  fileFormat    FileFormat
  fileSizeBytes Int?
  bankProvider  BankProvider
  periodStart   DateTime
  periodEnd     DateTime
  status        UploadStatus @default(UPLOADING)
  errorMessage  String?
  totalRows     Int          @default(0)
  parsedRows    Int          @default(0)
  failedRows    Int          @default(0)
  totalCredit   Decimal      @default(0) @db.Decimal(20, 2)
  totalDebit    Decimal      @default(0) @db.Decimal(20, 2)
  notes         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  bankAccount  BankAccount       @relation(fields: [bankAccountId], references: [id])
  uploadedBy   User              @relation(fields: [uploadedById], references: [id])
  transactions BankTransaction[]

  @@index([bankAccountId])
  @@index([uploadedById])
  @@index([status])
  @@index([periodStart, periodEnd])
  @@index([bankProvider])
}

model BankTransaction {
  id              String           @id @default(uuid())
  bankAccountId   String
  uploadId        String
  transactionDate DateTime
  valueDate       DateTime?
  description     String
  reference       String?
  amount          Decimal          @db.Decimal(20, 2)
  type            TransactionType
  balance         Decimal?         @db.Decimal(20, 2)
  status          EStatementStatus @default(PENDING)
  verifiedById    String?
  verifiedAt      DateTime?
  note            String?
  hash            String?          @unique
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  bankAccount BankAccount          @relation(fields: [bankAccountId], references: [id])
  upload      BankStatementUpload  @relation(fields: [uploadId], references: [id])
  verifiedBy  User?                @relation("VerifiedBy", fields: [verifiedById], references: [id])
  mergeItems  MergeReportItem[]
  categories  BankTransactionCategory[]

  @@index([bankAccountId])
  @@index([uploadId])
  @@index([transactionDate])
  @@index([type])
  @@index([status])
  @@index([reference])
}

model TransactionCategory {
  id          String   @id @default(uuid())
  userId      String?
  name        String
  code        String
  description String?
  createdAt   DateTime @default(now())

  user               User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankTransactions   BankTransactionCategory[]
  walletTransactions WalletTransactionCategory[]

  @@unique([userId, name])
  @@unique([userId, code])
  @@index([userId])
}

model MergeReport {
  id          String      @id @default(uuid())
  name        String
  periodStart DateTime
  periodEnd   DateTime
  status      MergeStatus @default(DRAFT)
  totalCredit Decimal     @default(0) @db.Decimal(20, 2)
  totalDebit  Decimal     @default(0) @db.Decimal(20, 2)
  netFlow     Decimal     @default(0) @db.Decimal(20, 2)
  createdById String
  notes       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  createdBy User              @relation(fields: [createdById], references: [id])
  items     MergeReportItem[]

  @@index([status])
  @@index([periodStart, periodEnd])
  @@index([createdById])
}

model MergeReportItem {
  id            String  @id @default(uuid())
  mergeReportId String
  transactionId String
  isDuplicate   Boolean @default(false)
  resolvedNote  String?

  mergeReport MergeReport     @relation(fields: [mergeReportId], references: [id], onDelete: Cascade)
  transaction BankTransaction @relation(fields: [transactionId], references: [id])

  @@unique([mergeReportId, transactionId])
  @@index([mergeReportId])
  @@index([isDuplicate])
}

model DigitalWallet {
  id             String         @id @default(uuid())
  walletProvider WalletProvider
  phoneNumber    String
  accountName    String
  description    String?
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  ownerId        String

  owner        User                    @relation(fields: [ownerId], references: [id])
  uploads      WalletStatementUpload[]
  transactions WalletTransaction[]

  @@unique([walletProvider, phoneNumber, ownerId])
  @@index([walletProvider])
  @@index([ownerId])
}

model WalletStatementUpload {
  id             String         @id @default(uuid())
  walletId       String
  uploadedById   String
  fileName       String
  fileUrl        String
  fileFormat     FileFormat
  fileSizeBytes  Int?
  walletProvider WalletProvider
  periodStart    DateTime
  periodEnd      DateTime
  status         UploadStatus   @default(UPLOADING)
  errorMessage   String?
  totalRows      Int            @default(0)
  parsedRows     Int            @default(0)
  failedRows     Int            @default(0)
  totalCredit    Decimal        @default(0) @db.Decimal(20, 2)
  totalDebit     Decimal        @default(0) @db.Decimal(20, 2)
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  wallet       DigitalWallet     @relation(fields: [walletId], references: [id])
  uploadedBy   User              @relation(fields: [uploadedById], references: [id])
  transactions WalletTransaction[]

  @@index([walletId])
  @@index([uploadedById])
  @@index([status])
  @@index([periodStart, periodEnd])
  @@index([walletProvider])
}

model WalletTransaction {
  id              String           @id @default(uuid())
  walletId        String
  uploadId        String
  transactionDate DateTime
  description     String
  reference       String?
  amount          Decimal          @db.Decimal(20, 2)
  type            TransactionType
  balance         Decimal?         @db.Decimal(20, 2)
  status          EStatementStatus @default(PENDING)
  verifiedById    String?
  verifiedAt      DateTime?
  note            String?
  hash            String?          @unique
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  wallet     DigitalWallet         @relation(fields: [walletId], references: [id])
  upload     WalletStatementUpload @relation(fields: [uploadId], references: [id])
  verifiedBy User?                 @relation("WalletVerifiedBy", fields: [verifiedById], references: [id])
  categories WalletTransactionCategory[]

  @@index([walletId])
  @@index([uploadId])
  @@index([transactionDate])
  @@index([type])
  @@index([status])
}

model BankTransactionCategory {
  transactionId String
  categoryId    String

  transaction BankTransaction     @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  category    TransactionCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([transactionId, categoryId])
  @@index([transactionId])
  @@index([categoryId])
}

model WalletTransactionCategory {
  transactionId String
  categoryId    String

  transaction WalletTransaction   @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  category    TransactionCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([transactionId, categoryId])
  @@index([transactionId])
  @@index([categoryId])
}

model OtpCode {
  id        String   @id @default(uuid())
  email     String
  code      String
  purpose   String   // "login" | "register" | "change-password" | "oauth"
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, purpose])
}

model Notification {
  id        String     @id @default(uuid())
  userId    String
  type      NotifType
  title     String
  message   String
  fileName  String?
  read      Boolean    @default(false)
  createdAt DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, read])
  @@index([createdAt])
}
